---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import FormattedDate from '@/components/FormattedDate.astro';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import { getPosts, type Post } from '@/lib/content';
import { readingTime } from '@/lib/format';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;
const { Content } = await render(post);
---

<ArticleLayout title={title} description={description} backHref="/blog/" backLabel="Blog">
  <Fragment slot="meta">
    <FormattedDate date={pubDate} />
    <span>&middot; {readingTime(post.body)}</span>
    {updatedDate && (
      <span>
        Updated <FormattedDate date={updatedDate} />
      </span>
    )}
    {tags.length > 0 && (
      <ul class="tags" aria-label="Tags">
        {tags.map((tag) => (
          <li>#{tag}</li>
        ))}
      </ul>
    )}
  </Fragment>
  <Content />
</ArticleLayout>

<style>
  /* Tags sit on their own row under the date line, as bordered chips. */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    flex-basis: 100%;
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 2px 10px;
    background: var(--surface);
    border: 1px solid color-mix(in srgb, var(--muted) 40%, var(--line));
    border-radius: 999px;
    font-size: 13px;
    line-height: 1.6;
  }
</style>
