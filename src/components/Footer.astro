---
import { REPO_URL, SITE, SOCIAL } from '@/site.config';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap bar">
    <p>
      &copy; {year} {SITE.name}
    </p>
    <ul>
      {SOCIAL.map(({ label, href }) => (
        <li>
          <a href={href}>{label}</a>
        </li>
      ))}
      <li>
        <a href="/rss.xml">RSS</a>
      </li>
      <li>
        <a href={REPO_URL}>Source</a>
      </li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 40px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 14px;
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 20px;
    padding-top: 16px;
    padding-bottom: 40px;
  }

  p {
    margin: 0;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    color: var(--muted);
  }

  a:hover {
    color: var(--accent);
  }
</style>
